@model AppUser
@{
    ViewData["Title"] = "Delete User";
}

<h1>Delete User</h1>
<p>Are you sure you want to delete this user?</p>
<dl class="row">
    <dt class="col-sm-2">User ID</dt><dd class="col-sm-10">@Model.UserID</dd>
    <dt class="col-sm-2">Name</dt><dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Email</dt><dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">User Type</dt><dd class="col-sm-10">@Model.UserType</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="UserID" />
    <input type="hidden" asp-for="Name" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>
