@model List<AppUser>
@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>
<p><a class="btn btn-primary" asp-action="Add">Add User</a></p>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>User ID</th>
                <th>Name</th>
                <th>Date of Birth</th>
                <th>Email</th>
                <th>SSN</th>
                <th>User Type</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserID</td>
                    <td>@user.Name</td>
                    <td>@user.DateOfBirth?.ToString("MM/dd/yyyy")</td>
                    <td>@user.Email</td>
                    <td>@user.SSN</td>
                    <td>@user.UserType</td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@user.UserID">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@user.UserID">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
