@model Major
@{
    ViewData["Title"] = "Delete Major";
}

<h1>Delete Major</h1>
<p>Are you sure you want to delete this major?</p>
<dl class="row">
    <dt class="col-sm-2">Major ID</dt><dd class="col-sm-10">@Model.MajorID</dd>
    <dt class="col-sm-2">Name</dt><dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">College</dt><dd class="col-sm-10">@Model.College</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="MajorID" />
    <input type="hidden" asp-for="Name" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>
