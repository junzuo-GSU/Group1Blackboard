@model List<Major>
@{
    ViewData["Title"] = "Majors";
}

<h1>Majors</h1>
<p><a class="btn btn-primary" asp-action="Add">Add Major</a></p>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Major ID</th><th>Name</th><th>College</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var major in Model)
            {
                <tr>
                    <td>@major.MajorID</td>
                    <td>@major.Name</td>
                    <td>@major.College</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@major.MajorID">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@major.MajorID">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
