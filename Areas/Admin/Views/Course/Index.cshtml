@model List<Course>
@{
    ViewData["Title"] = "Courses";
}

<h1>Courses</h1>
<p><a class="btn btn-primary" asp-action="Add">Add Course</a></p>

<div class="table-responsive">
    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr>
                <th>Course Number</th>
                <th>Course Name</th>
                <th>Credit</th>
                <th>Offered Semester</th>
                <th>Location</th>
                <th>Times</th>
                <th>Instructor</th>
                <th>Short Description</th>
                <th>Major</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>@course.CourseNumber</td>
                    <td>@course.Name</td>
                    <td>@course.Credit</td>
                    <td>@course.Semester</td>
                    <td>@course.Location</td>
                    <td>@course.Times</td>
                    <td>@course.Instructor.Name</td>
                    <td>@course.Description</td>
                    <td>@course.Major.Name</td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@course.CourseID">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@course.CourseID">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
