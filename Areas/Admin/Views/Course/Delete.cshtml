@model Course
@{
    ViewData["Title"] = "Delete Course";
}

<h1>Delete Course</h1>
<p>Are you sure you want to delete this course?</p>
<dl class="row">
    <dt class="col-sm-3">Course Number</dt><dd class="col-sm-9">@Model.CourseNumber</dd>
    <dt class="col-sm-3">Course Name</dt><dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Offered Semester</dt><dd class="col-sm-9">@Model.Semester</dd>
    <dt class="col-sm-3">Instructor</dt><dd class="col-sm-9">@Model.Instructor.Name</dd>
    <dt class="col-sm-3">Major</dt><dd class="col-sm-9">@Model.Major.Name</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="CourseID" />
    <input type="hidden" asp-for="CourseNumber" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>
