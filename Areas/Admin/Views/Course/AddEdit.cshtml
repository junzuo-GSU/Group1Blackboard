@model Course
@{
    ViewData["Title"] = ViewBag.Action + " Course";
}

<h1>@ViewBag.Action Course</h1>

<form asp-action="Save" method="post" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="CourseID" />

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="CourseNumber" class="form-label">Course Number</label>
            <input asp-for="CourseNumber" class="form-control" placeholder="e.g. CSPC8720" />
            <span asp-validation-for="CourseNumber" class="text-danger"></span>
        </div>
        <div class="col-md-8 mb-3">
            <label asp-for="Name" class="form-label">Course Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Credit" class="form-label"></label>
            <input asp-for="Credit" type="number" class="form-control" />
            <span asp-validation-for="Credit" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Semester" class="form-label">Offered Semester</label>
            <select asp-for="Semester" asp-items="@(ViewBag.Semesters as SelectList)" class="form-select"></select>
            <div class="form-text">All = offered in Spring, Fall, and Summer.</div>
            <span asp-validation-for="Semester" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Location" class="form-label"></label>
            <select asp-for="Location" asp-items="@(ViewBag.Locations as SelectList)" class="form-select"></select>
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Times" class="form-label"></label>
            <input asp-for="Times" class="form-control" placeholder="e.g. M/W 1:30 PM - 2:45 PM" />
            <span asp-validation-for="Times" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="InstructorID" class="form-label">Instructor</label>
            <select asp-for="InstructorID" asp-items="@(ViewBag.Instructors as SelectList)" class="form-select">
                <option value="0">-- Select an instructor --</option>
            </select>
            <span asp-validation-for="InstructorID" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="MajorID" class="form-label">Major</label>
        <select asp-for="MajorID" asp-items="@(ViewBag.Majors as SelectList)" class="form-select">
            <option value="0">-- Select a major --</option>
        </select>
        <span asp-validation-for="MajorID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Short Description</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>

@section scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}
